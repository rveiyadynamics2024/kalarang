# Public site URL (used for things like canonical links / share URLs)
VITE_APP_URL="http://localhost:3000"
VITE_ADMIN_EMAIL="admin@kalarang.com"

# Supabase project config (Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# This is a pure static site -- no server functions are required. Any host
# (Vercel, Netlify, Firebase Hosting, GitHub Pages, Cloudflare Pages,
# S3/CloudFront, your own server, etc.) just needs these set as build-time
# environment variables, plus a rewrite rule that sends all paths to
# /index.html (see vercel.json / public/_redirects / public/.htaccess).
#
# The VITE_SUPABASE_ANON_KEY is the public "anon" key -- safe to expose in
# the browser. Never put your service_role key in a VITE_ variable.
