# Dependencies — always installed fresh by npm, never commit these
node_modules/

# Build output — generated by `npm run build`, never commit this
dist/
dist-ssr/

# Local environment files — contain secrets, never commit these
.env
.env.local
.env.*.local

# Editor/OS junk
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*